# Copy this file to .env.local and fill in a Firebase project.
# .env.local is gitignored. Do not commit keys.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# First Super Admin. Used only by npm run admin:create.
FIREBASE_BOOTSTRAP_EMAIL=
FIREBASE_BOOTSTRAP_PASSWORD=
FIREBASE_BOOTSTRAP_NAME=
