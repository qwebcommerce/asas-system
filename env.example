# Copy this file to .env.local and fill in a Firebase project.
# .env.local is gitignored. Do not commit keys.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# First Super Admin. Used only by npm run admin:create.
FIREBASE_BOOTSTRAP_EMAIL=
FIREBASE_BOOTSTRAP_PASSWORD=
FIREBASE_BOOTSTRAP_NAME=

# Public address of the website, used for share links on blog posts (e.g. https://asasqa.com)
NEXT_PUBLIC_SITE_URL=

# Public host name(s) the system is opened from, comma-separated (e.g. asasqa.com,www.asasqa.com).
# Required when the app runs behind a proxy or custom domain that does not forward the public host,
# otherwise saving anything fails with a 500 error. Set it before building. The host of
# NEXT_PUBLIC_SITE_URL is included automatically.
SERVER_ACTIONS_ALLOWED_ORIGINS=

# AI assistant (daily reports) and weekly report summaries use the Claude API.
# Without it the assistant shows "not set up" and weekly reports are built from the figures only.
ANTHROPIC_API_KEY=

# Secret for the weekly-report schedule (vercel.json, Thursdays 18:00 Qatar time).
# Vercel sends it automatically to /api/cron/weekly-reports when it is set in the project.
CRON_SECRET=

# Company mailbox (Gmail, read-only) for the AI assistant. In Google Cloud (the company's Workspace):
# create a project, enable the Gmail API, set the OAuth consent screen to "Internal", create an
# OAuth client of type "Web application" and add the redirect URI shown in Settings > Company mailbox
# (https://<your-domain>/api/email/google/callback). Then a Super Admin presses "Connect Gmail".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Gmail token; any long random string (keep it secret, don't change it later).
EMAIL_TOKEN_KEY=
